---
import { siteConfig } from "../lib/site";
import Base from "../layouts/Base.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
    { label: "Writing", href: "/" },
    { label: "Topics", href: "/tags" },
];
---

<Base title={title} description={description}>
    <div class="mx-auto w-full max-w-[72rem] px-6 md:px-10">
        <!-- Masthead: wordmark + nav, closed by a newspaper double rule -->
        <header class="settle pt-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
                <a
                    href="/"
                    class="font-display text-[1.35rem] font-medium tracking-[-0.02em]"
                    aria-label={`${siteConfig.name} — home`}
                >
                    {siteConfig.name}
                </a>
                <nav
                    class="font-data flex items-center gap-6 text-[0.7rem] uppercase"
                    aria-label="Main"
                >
                    {
                        nav.map((item) => {
                            const current = path === item.href;
                            return (
                                <a
                                    href={item.href}
                                    aria-current={current ? "page" : undefined}
                                    class="bloom flex items-center gap-2"
                                >
                                    {current && <span class="contents-dot" aria-hidden="true" />}
                                    {item.label}
                                </a>
                            );
                        })
                    }
                    <a
                        href={siteConfig.portfolioUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="bloom"
                    >
                        Portfolio<span aria-hidden="true" class="ml-1">↗</span>
                    </a>
                </nav>
            </div>
            <div class="masthead-rule mt-5" aria-hidden="true"></div>
        </header>

        <main class="pb-24">
            <slot />
        </main>

        <!-- Colophon -->
        <footer class="border-t border-(--rule) py-10">
            <div
                class="font-data flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[0.7rem] uppercase text-(--ink-soft)"
            >
                <p>© {new Date().getFullYear()} {siteConfig.author}</p>
                <p class="normal-case tracking-normal italic text-(--ink-faint)">
                    Set in Playfair Display &amp; Newsreader
                </p>
                <div class="flex items-center gap-6">
                    <a href="/rss.xml" class="bloom">RSS</a>
                    <a href={siteConfig.portfolioUrl} target="_blank" rel="noreferrer" class="bloom">
                        anshroshan.com<span aria-hidden="true" class="ml-1">↗</span>
                    </a>
                </div>
            </div>
        </footer>
    </div>
</Base>
