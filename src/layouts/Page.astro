---
import { siteConfig } from "../lib/site";
import Base from "../layouts/Base.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = [
    { label: "Writing", href: "/" },
    { label: "Tags", href: "/tags" },
];
---

<Base title={title} description={description}>
    <div class="grain-overlay pointer-events-none fixed inset-0 z-50 opacity-[0.035]"></div>

    <header class="relative z-10">
        <nav
            class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-6 md:px-10"
        >
            <a
                href="/"
                class="font-display text-base font-semibold tracking-tight text-[#e7e7ea] transition-colors hover:text-[#22d3ee]"
            >
                {siteConfig.name}<span class="text-[#22d3ee]">_</span>
            </a>
            <div class="flex items-center gap-6">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            aria-current={path === link.href ? "page" : undefined}
                            class:list={[
                                "font-mono text-xs uppercase tracking-[0.18em] transition-colors",
                                path === link.href
                                    ? "text-[#22d3ee]"
                                    : "text-[#9a9aa4] hover:text-[#22d3ee]",
                            ]}
                        >
                            {link.label}
                        </a>
                    ))
                }
                <a
                    href={siteConfig.portfolioUrl}
                    class="font-mono text-xs uppercase tracking-[0.18em] text-[#9a9aa4] transition-colors hover:text-[#22d3ee]"
                >
                    Portfolio ↗
                </a>
            </div>
        </nav>
    </header>

    <main class="relative z-10">
        <slot />
    </main>

    <footer class="relative z-10 mt-16 border-t border-white/10">
        <div
            class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-8 md:px-10"
        >
            <p class="font-mono text-xs text-[#9a9aa4]">
                © {new Date().getFullYear()} {siteConfig.author}
            </p>
            <div class="flex items-center gap-5">
                <a
                    href="/rss.xml"
                    class="font-mono text-xs uppercase tracking-[0.16em] text-[#9a9aa4] transition-colors hover:text-[#22d3ee]"
                >
                    RSS
                </a>
                <a
                    href={siteConfig.portfolioUrl}
                    class="font-mono text-xs uppercase tracking-[0.16em] text-[#9a9aa4] transition-colors hover:text-[#22d3ee]"
                >
                    anshroshan.com ↗
                </a>
            </div>
        </div>
    </footer>
</Base>
