---
import { siteConfig } from "../lib/site";
import Base from "../layouts/Base.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
    { label: "Writing", href: "/" },
    { label: "Topics", href: "/tags" },
];
---

<Base title={title} description={description}>
    <!-- Masthead: the board's header rail -->
    <header class="roll-in">
        <div
            class="mx-auto flex w-full max-w-[76rem] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-5 md:px-10"
        >
            <a href="/" aria-label={`${siteConfig.name} — home`} class="group">
                <span
                    class="font-data border border-(--rule) px-3 py-1.5 text-[#9a9aa4] transition-colors group-hover:border-(--chrome) group-hover:text-(--chrome)"
                >
                    {siteConfig.name} <span class="text-(--chrome)">/ WRITING</span>
                </span>
            </a>

            <nav class="flex items-center gap-5" aria-label="Main">
                {
                    nav.map((item) => {
                        const current = path === item.href;
                        return (
                            <a
                                href={item.href}
                                aria-current={current ? "page" : undefined}
                                class:list={[
                                    "font-data flex items-center gap-2 transition-colors",
                                    current
                                        ? "text-(--chrome)"
                                        : "text-(--ink-soft) hover:text-(--chrome)",
                                ]}
                            >
                                {current && (
                                    <span
                                        class="inline-block h-1.5 w-1.5 rounded-full bg-(--chrome)"
                                        aria-hidden="true"
                                    />
                                )}
                                {item.label}
                            </a>
                        );
                    })
                }
                <button
                    type="button"
                    aria-label="Toggle light / dark mode"
                    title="Light / dark"
                    onclick={`try{var c=document.documentElement.classList;var d=c.toggle("dark");localStorage.setItem("blog-theme",d?"dark":"light");}catch(e){}`}
                    class="theme-toggle inline-flex h-7 w-7 items-center justify-center rounded-full border border-(--rule) text-(--ink-soft) transition-colors hover:border-(--chrome) hover:text-(--chrome)"
                >
                    <svg
                        class="icon-sun"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="4"></circle>
                        <path
                            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4l1.4 1.4"
                        ></path>
                    </svg>
                    <svg
                        class="icon-moon"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                    >
                        <path
                            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
                        ></path>
                    </svg>
                </button>
            </nav>
        </div>
        <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10">
            <div class="border-t-2 border-dashed border-(--seam)"></div>
        </div>
    </header>

    <main class="min-h-[60vh]">
        <slot />
    </main>

    <!-- Colophon plate -->
    <footer>
        <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10">
            <div class="seam">
                <span>End of the roll</span>
            </div>
        </div>
        <div
            class="font-data mx-auto flex w-full max-w-[76rem] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-10 text-(--ink-faint) md:px-10"
        >
            <p>© {new Date().getFullYear()} {siteConfig.author}</p>
            <p class="flex items-center gap-6">
                <a href="/rss.xml" class="transition-colors hover:text-(--chrome)">
                    RSS
                </a>
                <a
                    href={siteConfig.portfolioUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="transition-colors hover:text-(--chrome)"
                >
                    PORTFOLIO ↗
                </a>
            </p>
        </div>
    </footer>
</Base>
