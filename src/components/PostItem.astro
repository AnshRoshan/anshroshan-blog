---
import { formatDate, slugifyTag } from "../lib/posts";

interface Props {
    slug: string;
    title: string;
    description?: string;
    date: string;
    tags?: string[];
}

const { slug, title, description, date, tags } = Astro.props;
---

<article class="group flex flex-col gap-3 border-b border-white/10 py-7">
    <h2 class="font-display text-2xl font-semibold tracking-tight transition-colors group-hover:text-[#22d3ee]">
        <a href={`/blog/${slug}/`} class="text-[#e7e7ea] no-underline transition-colors group-hover:text-[#22d3ee]">
            {title}
        </a>
    </h2>

    {
        tags?.length ? (
            <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                    <a
                        href={`/tags/${slugifyTag(tag)}/`}
                        class="font-mono inline-flex items-center rounded-md border border-white/10 px-2.5 py-1 text-xs text-[#9a9aa4] no-underline transition-colors hover:border-[#22d3ee]/40 hover:text-[#22d3ee]"
                    >
                        {tag}
                    </a>
                ))}
            </div>
        ) : null
    }

    {
        description ? (
            <p class="max-w-2xl text-sm leading-relaxed text-[#9a9aa4]">
                {description}
            </p>
        ) : null
    }

    <div class="mt-1 flex items-center justify-between">
        <p class="font-mono flex items-center gap-1.5 text-xs text-[#9a9aa4]">
            {formatDate(date)}
        </p>
        <a
            href={`/blog/${slug}/`}
            class="inline-flex items-center gap-1.5 rounded-sm text-xs font-medium uppercase tracking-[0.12em] text-[#e7e7ea] no-underline transition-colors hover:text-[#22d3ee]"
        >
            Read more <span aria-hidden="true">→</span>
        </a>
    </div>
</article>
