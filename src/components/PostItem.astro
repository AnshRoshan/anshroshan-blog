---
import { formatDate, slugifyTag } from "../lib/posts";

interface Props {
    index?: number;
    slug: string;
    title: string;
    description?: string;
    date: string;
    tags?: string[];
    readTime?: string;
}

const { index, slug, title, description, date, tags, readTime } = Astro.props;
---

<article class="group border-b border-(--rule) py-8 first:pt-0">
    <a href={`/blog/${slug}/`} class="grid grid-cols-12 gap-x-4 gap-y-3 md:gap-x-8">
        {
            index !== undefined && (
                <span
                    class="font-data col-span-2 pt-2 text-(--ink-faint) md:col-span-1"
                    aria-hidden="true"
                >
                    {String(index).padStart(2, "0")}
                </span>
            )
        }
        <div class:list={[index !== undefined ? "col-span-10 md:col-span-8" : "col-span-12 md:col-span-9"]}>
            <h2
                class="font-display text-[1.55rem] leading-[1.15] font-medium tracking-[-0.02em] text-balance transition-colors duration-300 group-hover:text-(--vermilion)"
            >
                {title}
            </h2>
            {
                description && (
                    <p class="mt-2.5 max-w-[58ch] text-[1rem] leading-[1.6] text-(--ink-soft)">
                        {description}
                    </p>
                )
            }
            <div class="font-data mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.7rem] uppercase text-(--ink-faint)">
                <time datetime={date}>{formatDate(date)}</time>
                {tags?.length && (
                    <span class="hidden sm:inline" aria-hidden="true">·</span>
                )}
                {tags?.map((tag) => (
                    <span class="not-italic">{tag}</span>
                ))}
            </div>
        </div>
        {
            readTime && (
                <span class="font-data col-span-12 hidden pt-2 text-right text-(--ink-faint) md:col-span-3 md:block">
                    {readTime}
                </span>
            )
        }
    </a>
</article>
