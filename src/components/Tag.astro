---
import { slugifyTag } from "../lib/posts";

interface Props {
    tag: string;
    current?: boolean;
    count?: number;
}

const { tag, current = false, count } = Astro.props;
---

<a
    href={`/tags/${slugifyTag(tag)}/`}
    class:list={[
        "font-data inline-flex items-center gap-2 border px-2.5 py-1 text-[0.7rem] uppercase no-underline transition-colors duration-300",
        current
            ? "border-(--vermilion) text-(--vermilion)"
            : "border-(--rule) text-(--ink-soft) hover:border-(--vermilion) hover:text-(--vermilion)",
    ]}
>
    {current && <span class="contents-dot" aria-hidden="true" />}
    {tag}
    {count !== undefined && <span class="text-(--ink-faint)">{count}</span>}
</a>
