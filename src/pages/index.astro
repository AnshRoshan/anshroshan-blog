---
import Page from "../layouts/Page.astro";
import PostItem from "../components/PostItem.astro";
import Tag from "../components/Tag.astro";
import { getPosts, getAllTags, sortTagsByCount } from "../lib/posts";
import { siteConfig } from "../lib/site";

const posts = await getPosts();
const tags = getAllTags(posts);
const sortedTags = sortTagsByCount(tags);
---

<Page title={`${siteConfig.title}`} description={siteConfig.description}>
    <section class="relative mx-auto w-full max-w-5xl px-6 pt-12 pb-24 md:px-10 md:pt-16">
        <span class="eyebrow fade-up">Blog</span>
        <h1
            class="text-gradient font-display fade-up fade-up-1 mt-6 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl"
        >
            Writing
        </h1>
        <p class="fade-up fade-up-2 mt-4 max-w-[58ch] text-base text-[#9a9aa4]">
            Notes on Gen AI, building with LLMs, and shipping software end to
            end.
        </p>

        <div class="fade-up fade-up-3 mt-14 grid grid-cols-12 gap-10">
            <div class="col-span-12 lg:col-span-8">
                {
                    posts.length > 0 ? (
                        <ul class="flex flex-col border-t border-white/10">
                            {posts.map((post) => (
                                <li>
                                    <PostItem
                                        slug={post.slug}
                                        date={post.date}
                                        title={post.title}
                                        description={post.description}
                                        tags={post.tags}
                                    />
                                </li>
                            ))}
                        </ul>
                    ) : (
                        <p class="text-[#9a9aa4]">Nothing to see here yet.</p>
                    )
                }
            </div>

            <aside class="col-span-12 lg:col-span-4">
                <div class="rounded-[24px] border border-white/10 bg-[#131316]/70 p-6 backdrop-blur-xl">
                    <h2 class="font-mono text-xs uppercase tracking-[0.22em] text-[#9a9aa4]">
                        Tags
                    </h2>
                    <div class="mt-4 flex flex-wrap gap-2">
                        {
                            sortedTags.map((tag) => (
                                <Tag tag={tag} count={tags[tag]} />
                            ))
                        }
                    </div>
                </div>
            </aside>
        </div>
    </section>
</Page>
