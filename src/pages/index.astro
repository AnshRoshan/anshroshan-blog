---
import Page from "../layouts/Page.astro";
import PostItem from "../components/PostItem.astro";
import Tag from "../components/Tag.astro";
import {
    getPosts,
    getAllTags,
    sortTagsByCount,
    readTime,
    bodyToText,
} from "../lib/posts";
import { siteConfig } from "../lib/site";
import { urlForImage } from "../lib/image";

const posts = await getPosts();
const tags = getAllTags(posts);
const sortedTags = sortTagsByCount(tags);

// The issue's lead: the newest essay gets the display treatment.
const [lead, ...earlier] = posts;
const firstLines = bodyToText(lead?.body).slice(0, 180);
const leadDeck =
    lead?.description ??
    (firstLines.length ? `${firstLines.trim()}…` : "");
const leadCover = lead?.coverImage
    ? urlForImage(lead.coverImage).width(1600).url()
    : null;
---

<Page title={`${siteConfig.title}`} description={siteConfig.description}>
    {
        lead && (
            <section class="settle pt-14 md:pt-20">
                <a href={`/blog/${lead.slug}/`} class="group block">
                    {
                        leadCover && (
                            <img
                                src={leadCover}
                                alt={lead.coverImage?.alt || lead.title}
                                width="1600"
                                height="900"
                                loading="eager"
                                class="mb-10 aspect-[16/9] w-full rounded-[10px] border border-(--rule) object-cover"
                            />
                        )
                    }
                    <h1 class="font-display max-w-[24ch] text-[2.7rem] leading-[1.04] font-medium tracking-[-0.025em] text-balance transition-colors duration-300 group-hover:text-(--vermilion) md:text-[3.6rem]">
                        {lead.title}
                    </h1>
                    {leadDeck && (
                        <p class="mt-6 max-w-[62ch] text-[1.25rem] leading-[1.55] text-(--ink-soft) md:text-[1.35rem]">
                            {leadDeck}
                        </p>
                    )}
                    <div class="font-data mt-7 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.7rem] uppercase text-(--ink-faint)">
                        <time datetime={lead.date}>
                            {new Date(lead.date).toLocaleDateString("en-US", {
                                month: "long",
                                day: "numeric",
                                year: "numeric",
                            })}
                        </time>
                        <span aria-hidden="true">·</span>
                        <span>{readTime(lead.body)} read</span>
                        {lead.tags?.length && (
                            <>
                                <span aria-hidden="true">·</span>
                                <span>{lead.tags.join(" · ")}</span>
                            </>
                        )}
                        <span
                            class="font-data ml-1 text-(--vermilion)"
                            aria-hidden="true"
                        >
                            Read the essay →
                        </span>
                    </div>
                </a>
            </section>
        )
    }

    <div class="settle settle-1 mt-16 grid grid-cols-12 gap-x-4 gap-y-12 md:gap-x-10">
        <section class="col-span-12 lg:col-span-9">
            <h2
                class="font-data border-b border-(--rule-strong) pb-3 text-[0.7rem] uppercase text-(--ink-soft)"
            >
                Earlier writings
            </h2>
            <div class="mt-8">
                {
                    earlier.length > 0 ? (
                        earlier.map((post, i) => (
                            <PostItem
                                index={earlier.length - i}
                                slug={post.slug}
                                date={post.date}
                                title={post.title}
                                description={post.description}
                                tags={post.tags}
                                readTime={readTime(post.body)}
                            />
                        ))
                    ) : (
                        <p class="py-10 text-[1.05rem] italic text-(--ink-soft)">
                            The earlier writings are still in the drawer —
                            this is the first piece.
                        </p>
                    )
                }
            </div>
        </section>

        <aside class="col-span-12 lg:col-span-3">
            <h2
                class="font-data border-b border-(--rule) pb-3 text-[0.7rem] uppercase text-(--ink-soft)"
            >
                Topics
            </h2>
            <div class="mt-5 flex flex-wrap gap-2 lg:flex-col lg:items-start lg:gap-3">
                {
                    sortedTags.map((tag) => (
                        <Tag tag={tag} count={tags[tag]} />
                    ))
                }
            </div>
            <p class="font-data mt-8 text-[0.7rem] uppercase text-(--ink-faint)">
                <a href="/rss.xml" class="bloom">Subscribe via RSS</a>
            </p>
        </aside>
    </div>

    {
        !lead && (
            <section class="settle py-24 text-center">
                <h1 class="font-display text-[2.4rem] font-medium tracking-[-0.02em]">
                    The first essay is at the printers.
                </h1>
                <p class="mt-4 text-[1.05rem] italic text-(--ink-soft)">
                    Nothing is published yet — check back shortly.
                </p>
            </section>
        )
    }
</Page>
