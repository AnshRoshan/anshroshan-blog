---
import Page from "../../layouts/Page.astro";
import {
    getPosts,
    getAllTags,
    sortTagsByCount,
    slugifyTag,
    readTime,
    formatDate,
} from "../../lib/posts";
import { siteConfig } from "../../lib/site";

export async function getStaticPaths() {
    const posts = await getPosts();
    const tags = getAllTags(posts);
    return Object.keys(tags).map((tag) => ({
        params: { tag: slugifyTag(tag) },
        props: { tag },
    }));
}

const { tag } = Astro.props;
const posts = await getPosts();

// The Sanity tag strings aren't in the path params, so match on slugified tags.
const taggedPosts = posts.filter((post) =>
    post.tags?.some((t) => slugifyTag(t) === tag),
);
const displayTag =
    taggedPosts[0]?.tags?.find((t) => slugifyTag(t) === tag) ?? tag;
---

<Page
    title={`${displayTag} · ${siteConfig.name}`}
    description={`Essays tagged ${displayTag}.`}
>
    <section class="mx-auto w-full max-w-[76rem] px-6 pt-14 md:px-10 md:pt-20">
        <div class="seam roll-in"><span>Destination</span></div>
        <div class="roll-in roll-in-1 mt-8 flex flex-wrap items-end justify-between gap-6">
            <h1 class="font-display text-4xl text-(--ink) sm:text-6xl">
                {displayTag}
            </h1>
            <p class="font-data text-(--ink-faint)">
                {taggedPosts.length}
                {taggedPosts.length === 1 ? "essay" : "essays"} at this stop
            </p>
        </div>
    </section>

    <section class="mx-auto w-full max-w-[76rem] px-6 pt-10 md:px-10">
        <div class="roll-in roll-in-2 border-t border-(--rule)">
            {
                taggedPosts.map((post) => (
                    <a
                        href={`/blog/${post.slug}/`}
                        class="group grid grid-cols-12 items-baseline gap-x-6 gap-y-2 border-b border-(--rule) py-7 transition-colors hover:bg-(--panel)"
                    >
                        <div class="col-span-12 sm:col-span-8">
                            <h2 class="font-display text-xl tracking-[0.02em] text-(--ink) transition-colors group-hover:text-(--chrome) sm:text-2xl">
                                {post.title}
                            </h2>
                            {post.description && (
                                <p class="mt-1.5 max-w-[58ch] text-sm leading-relaxed text-(--ink-soft)">
                                    {post.description}
                                </p>
                            )}
                        </div>
                        <div class="col-span-12 flex flex-wrap items-center gap-3 sm:col-span-4 sm:justify-end">
                            <time class="font-data text-(--ink-faint)" datetime={post.date}>
                                {formatDate(post.date)}
                            </time>
                            <span class="font-data text-(--ink-faint)">
                                {readTime(post.body)}
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>

        <p class="mt-10">
            <a href="/tags/" class="font-data text-(--ink-soft) transition-colors hover:text-(--chrome)">
                ← All destinations
            </a>
        </p>
    </section>
</Page>
