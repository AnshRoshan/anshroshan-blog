---
import Page from "../../layouts/Page.astro";
import PostItem from "../../components/PostItem.astro";
import {
    getPosts,
    getAllTags,
    sortTagsByCount,
    slugifyTag,
    readTime,
} from "../../lib/posts";
import { siteConfig } from "../../lib/site";

export async function getStaticPaths() {
    const posts = await getPosts();
    const tags = getAllTags(posts);
    return Object.keys(tags).map((tag) => ({
        params: { tag: slugifyTag(tag) },
        props: { tag },
    }));
}

const { tag } = Astro.props;
const posts = await getPosts();

// The Sanity tag strings aren't in the path params, so match on slugified tags.
const taggedPosts = posts.filter((post) =>
    post.tags?.some((t) => slugifyTag(t) === tag),
);
const displayTag =
    taggedPosts[0]?.tags?.find((t) => slugifyTag(t) === tag) ?? tag;
---

<Page
    title={`${displayTag} · ${siteConfig.name}`}
    description={`Essays tagged ${displayTag}.`}
>
    <section class="settle pt-14 md:pt-20">
        <nav
            class="font-data text-[0.7rem] uppercase text-(--ink-faint)"
            aria-label="Back"
        >
            <a href="/tags/" class="bloom">← All topics</a>
        </nav>
        <h1 class="font-display mt-8 text-[2.4rem] font-medium tracking-[-0.025em] md:text-[3rem]">
            {displayTag}
        </h1>
        <p class="font-data mt-3 text-[0.7rem] uppercase text-(--ink-faint)">
            {taggedPosts.length}
            {taggedPosts.length === 1 ? "essay" : "essays"} under this topic
        </p>
    </section>

    <div class="settle settle-1 mt-10 border-t border-(--rule)">
        {
            taggedPosts.map((post) => (
                <PostItem
                    slug={post.slug}
                    date={post.date}
                    title={post.title}
                    description={post.description}
                    tags={post.tags}
                    readTime={readTime(post.body)}
                />
            ))
        }
    </div>
</Page>
