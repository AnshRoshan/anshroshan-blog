---
import Page from "../../layouts/Page.astro";
import { getPosts, getAllTags, sortTagsByCount, slugifyTag } from "../../lib/posts";
import { siteConfig } from "../../lib/site";

const posts = await getPosts();
const tags = getAllTags(posts);
const sortedTags = sortTagsByCount(tags);
---

<Page title={`Topics · ${siteConfig.name}`} description="Topics I've written about.">
    <section class="settle pt-14 md:pt-20">
        <h1 class="font-display text-[2.4rem] font-medium tracking-[-0.025em] text-balance md:text-[3rem]">
            Topics
        </h1>
        <p class="mt-4 max-w-[52ch] text-[1.1rem] italic text-(--ink-soft)">
            Every thread in the notebook, with the number of entries in each.
        </p>
    </section>

    <div class="settle settle-1 mt-12 border-t border-(--rule)">
        {
            sortedTags.length > 0 ? (
                sortedTags.map((tag) => (
                    <a
                        href={`/tags/${slugifyTag(tag)}/`}
                        class="group flex items-baseline justify-between border-b border-(--rule) py-5 transition-colors"
                    >
                        <span class="font-display text-[1.3rem] font-medium tracking-[-0.02em] transition-colors duration-300 group-hover:text-(--vermilion)">
                            {tag}
                        </span>
                        <span class="font-data text-[0.7rem] uppercase text-(--ink-faint)">
                            {tags[tag]} {tags[tag] === 1 ? "essay" : "essays"}
                        </span>
                    </a>
                ))
            ) : (
                <p class="border-b border-(--rule) py-10 text-[1.05rem] italic text-(--ink-soft)">
                    No topics yet — the notebook is empty.
                </p>
            )
        }
    </div>
</Page>
