---
import Page from "../../layouts/Page.astro";
import { getPosts, getAllTags, sortTagsByCount, slugifyTag } from "../../lib/posts";
import { siteConfig } from "../../lib/site";

const posts = await getPosts();
const tags = getAllTags(posts);
const sortedTags = sortTagsByCount(tags);
---

<Page
    title={`Topics · ${siteConfig.name}`}
    description="Every destination on the board, with the number of entries at each."
>
    <section class="mx-auto w-full max-w-[76rem] px-6 pt-14 md:px-10 md:pt-20">
        <div class="seam roll-in"><span>Destination board</span></div>
        <h1
            class="font-display roll-in roll-in-1 mt-8 text-4xl text-(--ink) sm:text-6xl"
        >
            Topics
        </h1>
        <p class="roll-in roll-in-2 mt-4 max-w-[52ch] text-(--ink-soft)">
            Every thread in the notebook, with the number of entries at each
            stop.
        </p>
    </section>

    <section class="mx-auto w-full max-w-[76rem] px-6 pt-12 md:px-10">
        <div class="roll-in roll-in-2 grid grid-cols-1 border border-(--rule) sm:grid-cols-2 lg:grid-cols-3">
            {
                sortedTags.map((tag, i) => (
                    <a
                        href={`/tags/${slugifyTag(tag)}/`}
                        class:list={[
                            "group border-(--rule) p-7 transition-colors hover:bg-(--panel)",
                            i < sortedTags.length - 1 && "border-b sm:border-b sm:border-r",
                        ]}
                    >
                        <span class="font-data text-(--chrome)">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h2 class="font-display mt-3 text-xl tracking-[0.02em] text-(--ink) transition-colors group-hover:text-(--chrome)">
                            {tag}
                        </h2>
                        <p class="font-data mt-2 text-(--ink-faint)">
                            {tags[tag]} {tags[tag] === 1 ? "essay" : "essays"}
                        </p>
                    </a>
                ))
            }
            {
                sortedTags.length === 0 && (
                    <p class="p-7 text-(--ink-soft)">
                        No topics yet — the board is blank.
                    </p>
                )
            }
        </div>
    </section>
</Page>
