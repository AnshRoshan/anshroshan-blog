---
import Page from "../layouts/Page.astro";
import { siteConfig } from "../lib/site";
---

<Page title={`Off route · ${siteConfig.name}`}>
    <section class="mx-auto w-full max-w-[76rem] px-6 py-28 text-center md:px-10 md:py-36">
        <div class="seam justify-center"><span>Signal fault</span></div>
        <p class="font-data mt-10 text-(--chrome)">Error 404</p>
        <h1 class="font-display mx-auto mt-6 max-w-[22ch] text-4xl leading-[1.05] text-(--ink) sm:text-6xl">
            This course was taken off the board.
        </h1>
        <p class="mx-auto mt-5 max-w-[46ch] text-(--ink-soft)">
            The address may have moved, or it never made it past the
            dispatcher.
        </p>
        <p class="mt-10">
            <a href="/" class="plate">← Back to the board</a>
        </p>
    </section>
</Page>
