---
import Page from "../layouts/Page.astro";
import { siteConfig } from "../lib/site";
---

<Page title={`Not found · ${siteConfig.name}`}>
    <section class="settle py-28 text-center md:py-36">
        <p class="font-data text-[0.7rem] uppercase text-(--ink-faint)">
            Page not found · 404
        </p>
        <h1 class="font-display mx-auto mt-6 max-w-[20ch] text-[2.4rem] leading-[1.08] font-medium tracking-[-0.025em] text-balance md:text-[3rem]">
            This page was cut from the final edition.
        </h1>
        <p class="mx-auto mt-5 max-w-[46ch] text-[1.05rem] italic text-(--ink-soft)">
            The address may have moved, or it never made it past the editor.
        </p>
        <p class="mt-9">
            <a
                href="/"
                class="bloom font-data text-[0.7rem] uppercase text-(--ink)"
            >
                ← Back to contents
            </a>
        </p>
    </section>
</Page>
