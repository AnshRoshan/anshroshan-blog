---
import Page from "../../layouts/Page.astro";
import Tag from "../../components/Tag.astro";
import {
    getPost,
    getPosts,
    formatDate,
    readTime,
    slugifyTag,
} from "../../lib/posts";
import { urlForImage } from "../../lib/image";
import { portableTextToHtml } from "../../lib/portable";
import { siteConfig } from "../../lib/site";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({
        params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
// The listing query omits bodies; fetch the full post for the essay page.
const post = await getPost(slug ?? "");
if (!post) {
    return new Response(null, { status: 404 });
}

// Chronological neighbours for end-of-essay navigation.
const all = await getPosts();
const idx = all.findIndex((p) => p.slug === slug);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

// Up to three related essays sharing a tag, excluding the current one.
const related = all
    .filter((p) => p.slug !== slug && p.tags?.some((t) => post.tags?.includes(t)))
    .slice(0, 3);
const bodyHtml = portableTextToHtml(post.body);
const coverImage = post.coverImage
    ? urlForImage(post.coverImage).width(1600).url()
    : null;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    author: {
        "@type": "Person",
        name: siteConfig.author,
        url: siteConfig.portfolioUrl,
    },
    url: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
    ...(coverImage ? { image: coverImage } : {}),
});
---

<Page title={`${post.title} · ${siteConfig.name}`} description={post.description}>
    <script type="application/ld+json" set:html={jsonLd} />
    <div class="progress-rail" aria-hidden="true"></div>

    <article class="settle pt-12 md:pt-16">
        <nav
            class="font-data text-[0.7rem] uppercase text-(--ink-faint)"
            aria-label="Back"
        >
            <a href="/" class="bloom">← Contents</a>
        </nav>

        <header class="mt-10 border-b border-(--rule) pb-10">
            <h1
                class="font-display max-w-[26ch] text-[2.4rem] leading-[1.06] font-medium tracking-[-0.025em] text-balance md:text-[3.2rem]"
            >
                {post.title}
            </h1>
            {
                post.description && (
                    <p class="mt-6 max-w-[60ch] text-[1.25rem] leading-[1.55] italic text-(--ink-soft)">
                        {post.description}
                    </p>
                )
            }
            <div class="font-data mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.7rem] uppercase text-(--ink-faint)">
                <span class="text-(--ink)">By {siteConfig.author}</span>
                <span aria-hidden="true">·</span>
                <time datetime={post.date}>{formatDate(post.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{readTime(post.body)} read</span>
            </div>
            {
                post.tags?.length && (
                    <div class="mt-5 flex flex-wrap gap-2">
                        {post.tags.map((tag) => (
                            <Tag tag={tag} />
                        ))}
                    </div>
                )
            }
        </header>

        {
            coverImage && (
                <figure class="mt-10">
                    <img
                        src={coverImage}
                        alt={post.coverImage?.alt || post.title}
                        width="1600"
                        height="900"
                        loading="eager"
                        class="aspect-[16/9] w-full rounded-[10px] border border-(--rule) object-cover"
                    />
                    {
                        post.coverImage?.alt && (
                            <figcaption class="mt-3 text-[0.95rem] italic text-(--ink-soft)">
                                {post.coverImage.alt}
                            </figcaption>
                        )
                    }
                </figure>
            )
        }

        <div class="essay mt-12" set:html={bodyHtml} />

        {
            (newer || older) && (
                <nav class="essay-nav" aria-label="More essays">
                    {older ? (
                        <a href={`/blog/${older.slug}/`}>
                            <span class="k">← Earlier</span>
                            <span class="t">{older.title}</span>
                        </a>
                    ) : (
                        <span />
                    )}
                    {newer ? (
                        <a href={`/blog/${newer.slug}/`} class="next">
                            <span class="k">Later →</span>
                            <span class="t">{newer.title}</span>
                        </a>
                    ) : (
                        <span />
                    )}
                </nav>
            )
        }

        {
            related.length > 0 && (
                <aside class="mt-12">
                    <h2 class="font-data border-b border-(--rule) pb-3 text-[0.7rem] uppercase text-(--ink-faint)">
                        Related essays
                    </h2>
                    <ul class="mt-5 flex flex-col gap-3">
                        {related.map((r) => (
                            <li class="flex items-baseline justify-between gap-6">
                                <a
                                    href={`/blog/${r.slug}/`}
                                    class="bloom font-display text-[1.05rem] font-medium"
                                >
                                    {r.title}
                                </a>
                                <span class="font-data shrink-0 text-[0.7rem] uppercase text-(--ink-faint)">
                                    {readTime(r.body)}
                                </span>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }

        <!-- End matter -->
        <footer class="mt-20 border-t border-(--rule-strong) pt-10">
            <div class="grid grid-cols-12 gap-x-4 gap-y-6 md:gap-x-8">
                <div class="col-span-12 md:col-span-8">
                    <p class="font-display text-[1.2rem] font-medium">
                        {siteConfig.author}
                    </p>
                    <p class="mt-2 max-w-[52ch] text-[1rem] leading-[1.6] text-(--ink-soft)">
                        Gen AI developer building agentic systems, RAG
                        pipelines, and full-stack AI products that ship to
                        production. This essay is part of an open notebook —
                        the working notes come from shipping, not theorizing.
                    </p>
                </div>
                <div class="col-span-12 md:col-span-4 md:text-right">
                    <p class="font-data text-[0.7rem] uppercase text-(--ink-faint)">
                        Continue
                    </p>
                    <p class="mt-3 space-x-5">
                        <a
                            href={`${siteConfig.portfolioUrl}/contact`}
                            target="_blank"
                            rel="noreferrer"
                            class="bloom font-data text-[0.7rem] uppercase"
                        >
                            Get in touch<span aria-hidden="true" class="ml-1">↗</span>
                        </a>
                        <a href="/" class="bloom font-data text-[0.7rem] uppercase">
                            More writings
                        </a>
                    </p>
                </div>
            </div>
        </footer>
    </article>
</Page>
