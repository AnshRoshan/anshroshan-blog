---
import Page from "../../layouts/Page.astro";
import { getPost, getPosts, formatDate, readTime } from "../../lib/posts";
import { urlForImage } from "../../lib/image";
import { portableTextToHtml } from "../../lib/portable";
import { siteConfig } from "../../lib/site";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({
        params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
const post = await getPost(slug ?? "");
if (!post) {
    return new Response(null, { status: 404 });
}

// Chronological neighbours for end-of-essay navigation.
const all = await getPosts();
const idx = all.findIndex((p) => p.slug === slug);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older =
    idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

// Up to three related essays sharing a tag, excluding the current one.
const related = all
    .filter(
        (p) => p.slug !== slug && p.tags?.some((t) => post.tags?.includes(t)),
    )
    .slice(0, 3);

const bodyHtml = portableTextToHtml(post.body);
const coverImage = post.coverImage
    ? urlForImage(post.coverImage).width(1600).url()
    : null;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    author: {
        "@type": "Person",
        name: siteConfig.author,
        url: siteConfig.portfolioUrl,
    },
    url: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
    ...(coverImage ? { image: coverImage } : {}),
});
---

<Page
    title={`${post.title} · ${siteConfig.name}`}
    description={post.description}
>
    <script type="application/ld+json" set:html={jsonLd} />
    <div class="progress-rail" aria-hidden="true"></div>

    <article class="mx-auto w-full max-w-[76rem] px-6 pt-12 md:px-10 md:pt-16">
        <!-- Course header: code plate + title -->
        <header class="roll-in">
            <div class="font-data flex flex-wrap items-center gap-4 text-(--chrome)">
                <span class="border border-(--chrome) px-2 py-1">
                    {new Date(post.date).toLocaleDateString("en-US", { month: "short", year: "numeric" })}
                </span>
                <span>{readTime(post.body)} read</span>
                <span aria-hidden="true">/</span>
                <a href="/" class="transition-colors hover:text-(--ink)">← All courses</a>
            </div>

            <h1
                class="font-display mt-7 max-w-[26ch] text-[2.5rem] leading-[1.02] text-(--ink) sm:text-[3.2rem] lg:text-[4rem]"
            >
                {post.title}
            </h1>

            {
                post.description && (
                    <p class="mt-6 max-w-[60ch] text-lg leading-[1.6] text-(--ink-soft)">
                        {post.description}
                    </p>
                )
            }

            {
                post.tags?.length && (
                    <div class="mt-7 flex flex-wrap gap-2">
                        {post.tags.map((tag) => (
                            <span class="dest-chip">{tag}</span>
                        ))}
                    </div>
                )
            }
        </header>

        {
            coverImage && (
                <figure class="roll-in roll-in-1 mt-10">
                    <img
                        src={coverImage}
                        alt={post.coverImage?.alt || post.title}
                        width="1600"
                        height="900"
                        loading="eager"
                        class="aspect-[16/9] w-full border border-(--rule) object-cover"
                    />
                    {post.coverImage?.alt && (
                        <figcaption>{post.coverImage.alt}</figcaption>
                    )}
                </figure>
            )
        }

        <!-- Reading panel: calico card, the lit blind -->
        <div
            class="roll-in roll-in-2 mt-12 border border-(--rule) bg-(--panel) p-7 sm:p-10 lg:p-14"
        >
            <div class="essay" set:html={bodyHtml} />

            {
                related.length > 0 && (
                    <aside class="mt-14 border-t-2 border-dashed border-(--seam) pt-8">
                        <h2 class="font-data text-(--ink-faint)">
                            Related courses
                        </h2>
                        <ul class="mt-5 flex flex-col gap-3">
                            {related.map((r) => (
                                <li class="flex items-baseline justify-between gap-6">
                                    <a
                                        href={`/blog/${r.slug}/`}
                                        class="font-display text-[1.05rem] tracking-[0.02em] text-(--ink) no-underline transition-colors hover:text-(--chrome)"
                                    >
                                        {r.title}
                                    </a>
                                    <span class="font-data shrink-0 text-(--ink-faint)">
                                        {readTime(r.body)}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </aside>
                )
            }
        </div>

        <!-- Prev / next -->
        {
            (newer || older) && (
                <nav class="essay-nav" aria-label="More courses">
                    {older ? (
                        <a href={`/blog/${older.slug}/`}>
                            <span class="k">← Earlier course</span>
                            <span class="t">{older.title}</span>
                        </a>
                    ) : (
                        <span aria-hidden="true" />
                    )}
                    {newer ? (
                        <a href={`/blog/${newer.slug}/`} class="next">
                            <span class="k">Later course →</span>
                            <span class="t">{newer.title}</span>
                        </a>
                    ) : (
                        <span aria-hidden="true" />
                    )}
                </nav>
            )
        }

        <!-- Author plate -->
        <footer class="mt-14 grid gap-6 border border-(--rule) bg-(--panel) p-7 sm:grid-cols-[1fr_auto] sm:items-center sm:p-9">
            <div>
                <p class="font-display text-lg tracking-[0.02em] text-(--ink)">
                    {siteConfig.author}
                </p>
                <p class="mt-1.5 max-w-[54ch] text-sm leading-relaxed text-(--ink-soft)">
                    AI Engineer at TCS. These notes come from shipping agentic
                    systems and RAG pipelines to production — not from
                    theorizing about them.
                </p>
            </div>
            <a
                href={`${siteConfig.portfolioUrl}/contact`}
                target="_blank"
                rel="noreferrer"
                class="plate w-fit"
            >
                Get in touch ↗
            </a>
        </footer>
    </article>
</Page>
